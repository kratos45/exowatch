# NASA API Key (use DEMO_KEY or your personal key from api.nasa.gov)
NASA_API_KEY=DEMO_KEY

# OpenRouter / OpenAI API Key for LLM enrichment
OPENROUTER_API_KEY=your_openrouter_key_here
OPENAI_API_KEY=your_openai_key_here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=google/gemini-2.0-flash-001

# Database path (curated SQLite store)
DATABASE_URL=sqlite:///data/curated/neo_curated.db
